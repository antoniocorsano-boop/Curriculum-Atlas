    {
      "stepId": "stimulus",
      "kind": "STIMULUS",
      "prompt": "Una pianta sul davanzale cresce inclinata verso la finestra. Perché?"
    },
    {
      "stepId": "hypothesis",
      "kind": "HYPOTHESIS",
      "prompt": "Scegli la spiegazione che ti sembra più plausibile all'inizio e annota il perché."
    },
    {
      "stepId": "evidence",
      "kind": "EVIDENCE",
      "prompt": "Confronta gli indizi: la pianta viene ruotata; dopo alcuni giorni i nuovi germogli si orientano nuovamente verso la finestra."
    },
    {
      "stepId": "compare",
      "kind": "COMPARE",
      "prompt": "Quale spiegazione usa meglio tutti gli indizi? Quale fatto crea un problema all'altra?"
    },
    {
      "stepId": "reflect",
      "kind": "REFLECT",
      "prompt": "La tua idea iniziale è cambiata? Spiega quale evidenza ha contato di più."
    },
    {
      "stepId": "reopen",
      "kind": "REOPEN",
      "prompt": "Quale nuova osservazione o prova vorresti fare per capire ancora meglio?"
    }
