{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curriculum-atlas.local/schemas/percorsi-pathway-seed.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pathwayId",
    "title",
    "version",
    "territoryIds",
    "competence",
    "coreStrategy",
    "evidenceGoal",
    "initialContext",
    "transferContext",
    "provenanceRef",
    "cognitiveFunctions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "atlas.percorsi.seed/v1"
    },
    "pathwayId": {
      "type": "string",
      "pattern": "^pw-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "territoryIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "self",
          "learning",
          "others",
          "problems",
          "world",
          "design"
        ]
      }
    },
    "competence": {
      "type": "string",
      "minLength": 10
    },
    "coreStrategy": {
      "type": "string",
      "minLength": 10
    },
    "evidenceGoal": {
      "type": "string",
      "minLength": 10
    },
    "initialContext": {
      "type": "string",
      "minLength": 10
    },
    "transferContext": {
      "type": "string",
      "minLength": 10
    },
    "provenanceRef": {
      "type": "string",
      "minLength": 1
    },
    "cognitiveFunctions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orient",
        "practice",
        "transfer",
        "reflect"
      ],
      "properties": {
        "orient": {
          "type": "string",
          "minLength": 1
        },
        "practice": {
          "type": "string",
          "minLength": 1
        },
        "transfer": {
          "type": "string",
          "minLength": 1
        },
        "reflect": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
