{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curriculum-atlas.local/schemas/smart-percorsi-handoff.schema.json",
  "title": "Smart Percorsi Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestDigest",
    "materialSet",
    "candidateBinding",
    "authorityRef",
    "authorityEvidenceRef",
    "resources",
    "handoffState",
    "runtimeAuthorized",
    "q5Produced"
  ],
  "properties": {
    "schemaVersion": {
      "const": "atlas.smart.percorsi-handoff/v1"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "materialSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialSetId",
        "version",
        "activityId",
        "eligibility"
      ],
      "properties": {
        "materialSetId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "activityId": {
          "type": "string",
          "minLength": 1
        },
        "eligibility": {
          "const": "PUBLICATION_CANDIDATE"
        }
      }
    },
    "candidateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeExactHead",
        "pathwayId",
        "contentVersion",
        "publicationId"
      ],
      "properties": {
        "runtimeExactHead": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "pathwayId": {
          "type": "string",
          "minLength": 1
        },
        "contentVersion": {
          "type": "string",
          "minLength": 1
        },
        "publicationId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authorityRef": {
      "type": "string",
      "minLength": 1
    },
    "authorityEvidenceRef": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resourceId",
          "digest",
          "byteSize",
          "publicationPath",
          "provenanceRef"
        ],
        "properties": {
          "resourceId": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0
          },
          "publicationPath": {
            "type": "string",
            "pattern": "^/materials/"
          },
          "provenanceRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "handoffState": {
      "const": "READY_FOR_Q5_INPUT"
    },
    "runtimeAuthorized": {
      "const": false
    },
    "q5Produced": {
      "const": false
    }
  }
}
