  "$id": "atlas.smart.flow-package/v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "activityId",
    "intentRef",
    "planRef",
    "experienceRef",
    "materialSetRef",
    "qualificationProfileRef",
    "stages"
  ],
  "properties": {
