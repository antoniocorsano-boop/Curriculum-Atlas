    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "intentRef": {
      "type": "string",
      "minLength": 1
    },
    "activityId": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "delivery": {
      "type": "object"
    },
    "materialNeeds": {
      "type": "array"
    }
  }
}
