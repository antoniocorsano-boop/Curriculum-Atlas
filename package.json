{
  "name": "curriculum-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:materials:valid": "node scripts/validate-material-publication.mjs --valid fixtures/material-publication/valid/lesson-materials.json",
    "validate:materials:invalid": "node scripts/validate-material-publication.mjs --invalid fixtures/material-publication/invalid/student-data.json fixtures/material-publication/invalid/asset-contract.json",
    "validate:materials": "npm run validate:materials:valid && npm run validate:materials:invalid"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "@xyflow/react": "^12.8.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "@eslint/eslintrc": "^3.3.1",
    "playwright": "^1.55.0"
  },
  "packageManager": "pnpm@10.17.1"
}
