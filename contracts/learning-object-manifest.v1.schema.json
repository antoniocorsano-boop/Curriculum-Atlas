{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curriculum-atlas.local/contracts/learning-object-manifest.v1.schema.json",
  "title": "LearningObjectManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "loId",
    "title",
    "discipline",
    "grade",
    "version",
    "lifecycle",
    "manifestUrl",
    "sourceRefs",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "loId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "discipline": {
      "type": "string",
      "minLength": 1
    },
    "grade": {
      "type": "string",
      "enum": [
        "Prima",
        "Seconda",
        "Terza"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "DRAFT",
        "GENERATED",
        "REVIEWED",
        "CANONICAL",
        "RETIRED"
      ]
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "manifestUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "patternApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "primaryPatternId"
      ],
      "properties": {
        "appId": {
          "type": "string",
          "minLength": 1
        },
        "primaryPatternId": {
          "type": "string",
          "minLength": 1
        },
        "secondaryPatternIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artId",
          "role",
          "label",
          "url",
          "format",
          "version"
        ],
        "properties": {
          "artId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "LIM",
              "MAP",
              "STUDENT",
              "TEACHER",
              "ASSESSMENT",
              "RECEIPT"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
